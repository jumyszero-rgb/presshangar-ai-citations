msgstr ""
"Este plugin é útil para você? Uma avaliação rápida ajuda outras pessoas a "
"descobri-lo — obrigado!"

#: includes/class-phcite-admin.php:0
msgid "Leave a review ★★★★★"
msgstr "Deixe uma avaliação ★★★★★"

#: includes/class-phcite-admin.php:0
msgid "No thanks"
msgstr "Não, obrigado"
